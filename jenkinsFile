/*
* =====================================================================
* Декларативный конвейер Jenkins (Declarative Pipeline)
* =====================================================================
*
* Declarative Pipeline — это один из двух синтаксисов Jenkins Pipeline.
* В отличие от Scripted Pipeline (скриптовый), декларативный предоставляет
* более строгую и структурированную форму записи. Он обязывает использовать
* блоки pipeline { ... }, stages { ... } и другие предопределённые секции.
* Это делает код более читаемым и предсказуемым, особенно для новичков.
*
* Ключевые особенности Declarative Pipeline:
*  - Обязателен блок pipeline { }
*  - Обязателен блок agent (определяет, где будет выполняться пайплайн)
*  - Все шаги должны быть внутри stages { }
*  - Есть удобные блоки: post, options, environment, tools и др.
*/
pipeline {

   /*
    * -----------------------------------------------------------------
    * agent — указывает, на каком агенте (узле Jenkins) будет
    * выполняться весь пайплайн.
    *
    * «any» означает: запустить на любом доступном агенте.
    * Jenkins сам выберет свободный узел (master или любой worker).
    *
    * Другие варианты:
    *  agent none    — не назначать агент автоматически;
    *                   каждый stage должен указать свой agent
    *  agent { label 'linux' } — запустить только на узле с меткой «linux»
    *  agent { docker 'openjdk:11' } — запустить в Docker-контейнере
    * -----------------------------------------------------------------
    */
   agent any


   /*
    * -----------------------------------------------------------------
    * tools — блок для автоматической установки и настройки
    * инструментов, которые были предварительно зарегистрированы
    * в Jenkins (Manage Jenkins → Global Tool Configuration).
    *
    * Указанные здесь инструменты:
    *  - Автоматически добавляются в PATH текущего запуска
    *  - Доступны во всех стадиях пайплайна
    *
    * JDK11 — имя конфигурации JDK, зарегистрированной в Jenkins.
    *          Гарантирует, что команды java/javac будут нужной версии.
    *
    * Maven — имя конфигурации Apache Maven, зарегистрированной в Jenkins.
    *          Гарантирует, что команда mvn доступна и нужной версии.
    *
    * Без этого блока Jenkins может использовать системный JDK/Maven,
    * версия которых не совпадает с требованиями проекта.
    * -----------------------------------------------------------------
    */
   tools {
       jdk 'JDK11'
       maven 'Maven'
   }


   /*
    * -----------------------------------------------------------------
    * environment — блок для определения переменных окружения,
    * которые будут доступны во всех стадиях пайплайна.
    *
    * MAVEN_OPTS — стандартная переменная Maven, через которую
    * передаются дополнительные JVM-опции при запуске mvn.
    *
    * Здесь мы задаём локальный репозиторий зависимостей внутри
    * рабочего пространства Jenkins ($WORKSPACE/.m2/repository).
    *
    * Зачем это нужно:
    *  - По умолчанию Maven хранит зависимости в ~/.m2/repository,
    *    который общий для всех сборок на узле. Это может вызвать
    *    конфликты между параллельными сборками.
    *  - Изоляция репозитория в $WORKSPACE гарантирует, что каждая
    *    сборка использует свой кэш зависимостей.
    *  - Также это ускоряет сборку, т.к. зависимости кэшируются
    *    между запусками одного и того же пайплайна.
    * -----------------------------------------------------------------
    */
   environment {
       MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2/repository'
   }


   /*
    * -----------------------------------------------------------------
    * options — глобальные настройки выполнения пайплайна.
    * Применяются ко всему пайплайну, а не к отдельным стадиям.
    * -----------------------------------------------------------------
    */
   options {
       /*
        * timestamps() — добавляет временную метку к каждой строке
        * в консольном выводе. Без этой опции в логе будут только
        * сами сообщения, без времени. С ней каждая строка выглядит так:
        *   [2024-01-15T10:30:45.123Z] + mvn clean test
        * Очень полезно для анализа длительности шагов.
        */
       timestamps()


       /*
        * ansiColor('xterm') — включает поддержку ANSI-цветов
        * в консольном выводе Jenkins. Без этой опции цветные
        * символы (например, от Maven или тестов) отображаются
        * как нечитаемые спецсимволы. 'xterm' — тип цветовой схемы.
        */
       ansiColor('xterm')


       /*
        * timeout(time: 30, unit: 'MINUTES') — если весь пайплайн
        * не завершится за 30 минут, Jenkins прервёт его со статусом
        * ABORTED. Защищает от «зависших» сборок, которые бесконечно
        * потребляют ресурсы агента.
        */
       timeout(time: 30, unit: 'MINUTES')


       /*
        * buildDiscarder — указывает, сколько прошлых сборок
        * (и их логов) нужно хранить. logRotator с numToKeepStr: '20'
        * означает: хранить только 20 последних сборок, остальные
        * автоматически удалять. Предотвращает переполнение диска.
        */
       buildDiscarder(logRotator(numToKeepStr: '20'))
   }


   /*
    * -----------------------------------------------------------------
    * stages — основной блок пайплайна, содержащий стадии (этапы)
    * выполнения. Каждая stage — это логический шаг, который
    * отображается в интерфейсе Jenkins как отдельный блок.
    * Стадии выполняются последовательно, сверху вниз.
    * -----------------------------------------------------------------
    */
   stages {


       /*
        * Stage 1: Checkout
        * Первая стадия — получение исходного кода из системы
        * контроля версий. Без неё у нас не будет кода для сборки.
        *
        * checkout scm — специальная команда Jenkins, которая
        * забирает код из репозитория, указанного в конфигурации
        * задачи (Multibranch Pipeline или настроенный SCM).
        * «scm» = Source Code Management — ссылка на настроенный
        * репозиторий (Git, SVN и др.).
        */
       stage('Checkout') {
           steps {
               checkout scm
           }
       }


       /*
        * Stage 2: Build & Test
        * Вторая стадия — компиляция проекта и запуск тестов.
        *
        * mvn clean test — команда Maven, которая:
        *  1. clean   — удаляет папку target/ от предыдущей сборки
        *  2. test    — компилирует код, затем запускает тесты
        *              (включает фазы: validate → compile → test)
        *
        * Если хотя бы один тест упадёт — Maven вернёт ненулевой
        * код возврата, и Jenkins отметит стадию как FAILED.
        */
       stage('Build & Test') {
           steps {
               sh 'mvn clean test'
           }
       }


       /*
        * Stage 3: Allure Report
        * Третья стадия — генерация HTML-отчёта Allure
        * из результатов тестирования.
        *
        * mvn allure:report — команда плагина allure-maven,
        * которая читает JSON-файлы из target/allure-results/
        * и генерирует интерактивный HTML-отчёт в
        * target/site/allure-report/index.html.
        *
        * Этот отчёт можно посмотреть через publishHTML (в post)
        * или через Allure Plugin (также в post).
        */
       stage('Allure Report') {
           steps {
               sh 'mvn allure:report'
           }
       }
   }


   /*
    * -----------------------------------------------------------------
    * post — блок действий, которые выполняются ПОСЛЕ всех стадий.
    * В отличие от stages, здесь шаги зависят от результата сборки.
    *
    * Подблоки post и когда они выполняются:
    *  always   — выполняется ВСЕГДА, независимо от результата
    *  success  — только если сборка успешна
    *  failure  — только если сборка упала
    *  unstable — только если сборка нестабильна (например, тесты упали)
    *  cleanup  — выполняется всегда, ПОСЛЕ всех остальных post-блоков
    * -----------------------------------------------------------------
    */
   post {


       /*
        * always — действия, которые нужно выполнить при любом
        * исходе сборки (успех, провал, нестабильность).
        * Здесь мы собираем артефакты и публикуем отчёты,
        * т.к. они нужны даже при проваленных тестах — чтобы
        * понять, что именно пошло не так.
        */
       always {
           /*
            * allure — шаг плагина Allure Jenkins Plugin.
            * Собирает результаты из указанной папки и отображает
            * их в интерфейсе Jenkins (кнопка «Allure Report» на
            * странице сборки).
            *
            * Параметры:
            *  includeProperties: false — не читать allure.properties
            *    из classpath (используем только настройки пайплайна)
            *  jdk: 'JDK11' — JDK для запуска утилиты allure
            *  results: [[path: 'target/allure-results']] — путь
            *    к папке с JSON-результатами тестов
            */
           allure includeProperties: false, jdk: 'JDK11', results: [[path: 'target/allure-results']]


           /*
            * archiveArtifacts — сохраняет указанные файлы как
            * «артефакты сборки» в Jenkins. Артефакты можно скачать
            * из интерфейса или использовать в других пайплайнах.
            *
            * Параметры:
            *  artifacts: 'target/allure-results/**' — маска файлов
            *    (** означает любые подпапки и файлы в них)
            *  allowEmptyArchive: true — не падать, если файлов нет
            *    (полезно при первом запуске или если тесты не сгенерировали
            *    результаты)
            *  fingerprint: true — создать отпечаток (fingerprint)
            *    для отслеживания, где используется этот артефакт
            */
           archiveArtifacts artifacts: 'target/allure-results/**', allowEmptyArchive: true, fingerprint: true


           /*
            * publishHTML — шаг плагина HTML Publisher.
            * Публикует HTML-отчёт (сгенерированный mvn allure:report)
            * как ссылку на странице сборки в Jenkins.
            *
            * Параметры:
            *  allowMissing: true — не падать, если отчёт не найден
            *  alwaysLinkToLastBuild: true — показывать ссылку на
            *    последний отчёт даже в старых сборках
            *  keepAll: true — сохранять отчёты для всех сборок
            *    (а не только последней)
            *  reportDir: 'target/site/allure-report' — папка с HTML
            *  reportFiles: 'index.html' — точка входа в отчёт
            *  reportName: 'Allure Report' — имя ссылки в Jenkins
            *  reportTitles: 'Allure Report' — заголовок вкладки браузера
            */
           publishHTML(target: [
               allowMissing: true,
               alwaysLinkToLastBuild: true,
               keepAll: true,
               reportDir: 'target/site/allure-report',
               reportFiles: 'index.html',
               reportName: 'Allure Report',
               reportTitles: 'Allure Report'
           ])
       }


       /*
        * failure — выполняется ТОЛЬКО при провале сборки.
        * Используется для уведомлений и диагностики.
        * Здесь мы выводим ключевую информацию о проваленной
        * сборке в консоль — это помогает быстро найти проблему.
        *
        * env.JOB_NAME  — имя задачи Jenkins (например, «my-project/main»)
        * env.BUILD_NUMBER — номер сборки (например, «42»)
        * env.BUILD_URL — прямая ссылка на сборку в веб-интерфейсе
        */
       failure {
           echo "BUILD FAILED! Check the console output for details."
           echo "Project: ${env.JOB_NAME}, Build: ${env.BUILD_NUMBER}"
           echo "URL: ${env.BUILD_URL}"
       }
       /*
        * cleanup — выполняется ВСЕГДА, после всех остальных
        * post-блоков (always, failure, success и т.д.).
        * Идеальное место для финальной уборки.
        *
        * cleanWs() — шаг плагина Workspace Cleanup.
        * Полностью удаляет содержимое рабочего пространства
        * ($WORKSPACE). Это гарантирует, что следующая сборка
        * начнётся с чистого состояния, без «мусора» от предыдущих
        * запусков (скрытых файлов, кэша и т.д.).
        */
       cleanup {
           cleanWs()
       }
   }
}

